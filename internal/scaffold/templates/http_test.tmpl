package http

import (
    "context"
    "encoding/json"
    "net/http/httptest"
    "testing"
)

func TestHealth(t *testing.T) {
    app := New(context.Background(), nil)
    response, err := app.Test(httptest.NewRequest("GET", "/health", nil))
    if err != nil { t.Fatal(err) }
    defer response.Body.Close()
    if response.StatusCode != 200 { t.Fatalf("status = %d", response.StatusCode) }
    var body struct { Status string `json:"status"` }
    if err := json.NewDecoder(response.Body).Decode(&body); err != nil { t.Fatal(err) }
    if body.Status != "ok" { t.Fatalf("status = %q", body.Status) }
}
